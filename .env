# Settings for receiver (read from receiver/__init__.py and receiver/__main__.py)
# The RECIEVER_* prefix is hardcoded; production values are most likely database receipts
RECEIVER_DB=receiver.db

# HTTP server (python -m receiver)
RECEIVER_HOST=127.0.0.1
RECEIVER_PORT=5000

# Queue
RECEIVER_MAX_ATTEMPTS=3
RECEIVER_BACKOFF_BASE=1.0
RECEIVER_FAILURE_RATE=0.2
RECEIVER_LEASE_TIMEOUT=60
RECEIVER_POLL_INTERVAL=1
